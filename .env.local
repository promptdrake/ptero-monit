# Environment mode: sandbox or production
NODE_ENV=sandbox

# Server Configuration
PORT=3000
HOST=0.0.0.0

# (Options: mysql | postgresql | sqlite | mongodb)
DB_TYPE=sqlite

# 1. MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pterooverload

# 2. PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=pterooverload

# 3. SQLite Configuration
SQLITE_FILE=data/app.db

# 4. MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=pterooverload
