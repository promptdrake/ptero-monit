<%- include('partials/head', { title: 'List Server - Pterodactyl Server Monitor', bodyClass: 'bg-body' }) %>
<div class="d-flex flex-column lg:flex-row app-shell">
  <%- include('partials/sidebar', { active: 'servers', admin }) %>

  <main class="flex-grow-1 p-3 lg:p-4 bg-2">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
      <div>
        <h1 class="h3 mb-1">List Server</h1>
        <p class="text-sm fg-3 mb-0">Add Wings nodes and monitor the servers running on them.</p>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge theme-secondary rounded-pill">Check interval: <%= autoCheckInterval %>s</span>
        <span class="badge theme-secondary rounded-pill"><%= servers.length %> node(s)</span>
      </div>
    </div>

    <% if (testResult) { %>
      <div class="alert <%= testResult.ok ? 'theme-success' : 'theme-danger' %> text-sm mt-3" role="alert">
        <strong><%= testResult.serverName %>:</strong> <%= testResult.message %>
      </div>
    <% } %>

    <div class="row g-3 mt-3">
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <div>
              <h2 class="h5 mb-1">Add Server</h2>
              <p class="text-sm fg-3 mb-0">Each entry represents a Wings node. The node API key is used to read servers and usage.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert theme-danger text-sm" role="alert"><%= error %></div>
            <% } %>

            <div id="test-result"></div>

            <form action="/servers" method="POST" id="server-form" class="d-grid gap-3">
              <div class="row g-3">
                <div class="col-12 sm:col-6">
                  <div class="form-field">
                    <label class="form-label" for="name">Server Name</label>
                    <input type="text" class="form-control" id="name" name="name" placeholder="Node 1" value="<%= form.name %>" required>
                  </div>
                </div>

                <div class="col-12 sm:col-6">
                  <div class="form-field">
                    <label class="form-label" for="node_id">Node ID</label>
                    <input type="text" class="form-control" id="node_id" name="node_id" placeholder="1" value="<%= form.nodeId %>" required>
                  </div>
                </div>

                <div class="col-12 sm:col-6">
                  <div class="form-field">
                    <label class="form-label" for="node_api_key">Node API Key</label>
                    <input type="password" class="form-control" id="node_api_key" name="node_api_key" placeholder="Daemon token" value="<%= form.nodeApiKey %>" autocomplete="off" required>
                  </div>
                </div>

                <div class="col-12 sm:col-6">
                  <div class="form-field">
                    <label class="form-label" for="wings_url">Wings URL</label>
                    <input type="text" class="form-control" id="wings_url" name="wings_url" placeholder="https://node.example.com:8080" value="<%= form.wingsUrl %>" required>
                  </div>
                </div>
              </div>

              <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-solid theme-primary btn-sm">Add Server</button>
                <button type="button" class="btn btn-outline theme-secondary btn-sm" id="test-connection">Test Connection</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-body">
            <div>
              <h2 class="h5 mb-1">Monitored Servers</h2>
              <p class="text-sm fg-3 mb-0">All entries are checked every <%= autoCheckInterval %> seconds, based on the Auto Check Interval in Settings.</p>
            </div>

            <% if (servers.length === 0) { %>
              <p class="text-sm fg-3 mb-0">No servers have been added yet.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-sm">
                  <thead>
                    <tr class="fg-2">
                      <th scope="col" class="fw-semibold">Server Name</th>
                      <th scope="col" class="fw-semibold">Node ID</th>
                      <th scope="col" class="fw-semibold">Wings URL</th>
                      <th scope="col" class="fw-semibold">Added</th>
                      <th scope="col" class="fw-semibold text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% servers.forEach(function (server) { %>
                      <tr>
                        <td><%= server.name %></td>
                        <td><%= server.nodeId %></td>
                        <td class="text-truncate" style="max-width: 280px;"><%= server.wingsUrl %></td>
                        <td class="fg-3"><%= server.createdAt %></td>
                        <td class="text-end">
                          <div class="d-flex justify-content-end gap-2">
                            <a href="/servers/<%= server.id %>/check" class="btn btn-outline theme-secondary btn-sm">Check</a>
                            <form action="/servers/<%= server.id %>/delete" method="POST" onsubmit="return confirm('Delete this server?');">
                              <button type="submit" class="btn btn-outline theme-danger btn-sm">Delete</button>
                            </form>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<script>
  (function () {
    var form = document.getElementById('server-form');
    var button = document.getElementById('test-connection');
    var target = document.getElementById('test-result');
    if (!form || !button || !target) return;

    button.addEventListener('click', async function () {
      var data = new URLSearchParams();
      data.set('name', form.elements.name.value);
      data.set('node_id', form.elements.node_id.value);
      data.set('node_api_key', form.elements.node_api_key.value);
      data.set('wings_url', form.elements.wings_url.value);

      button.disabled = true;
      target.innerHTML = '<div class="alert theme-info text-sm" role="alert">Checking connection...</div>';

      try {
        var response = await fetch('/servers/test', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: data.toString()
        });
        var result = await response.json();
        var alert = document.createElement('div');
        alert.className = 'alert text-sm ' + (result.ok ? 'theme-success' : 'theme-danger');
        alert.setAttribute('role', 'alert');
        alert.textContent = result.message || (result.ok ? 'Connection successful.' : 'Connection failed.');
        target.innerHTML = '';
        target.appendChild(alert);
      } catch (error) {
        target.innerHTML = '<div class="alert theme-danger text-sm" role="alert">Unable to check the connection.</div>';
      } finally {
        button.disabled = false;
      }
    });
  })();
</script>
<%- include('partials/foot') %>
