<%- include('partials/head', { title: 'Docker - Pterodactyl Server Monitor', bodyClass: 'bg-body' }) %>
<div class="d-flex flex-column lg:flex-row app-shell">
  <%- include('partials/sidebar', { active: 'docker', admin }) %>

  <main class="flex-grow-1 p-3 lg:p-4 bg-2">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
      <div>
        <h1 class="h3 mb-1">Docker</h1>
        <p class="text-sm fg-3 mb-0">Servers reported by each Wings node, with live status and usage.</p>
      </div>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge theme-secondary rounded-pill"><%= totals.nodes %> node(s)</span>
        <span class="badge theme-secondary rounded-pill"><%= totals.servers %> server(s)</span>
        <span class="badge theme-success rounded-pill"><%= totals.running %> running</span>
        <a href="/docker" class="btn btn-outline theme-secondary btn-sm">Refresh</a>
      </div>
    </div>

    <% if (totals.nodes === 0) { %>
      <div class="card shadow-sm mt-3">
        <div class="card-body">
          <div>
            <h2 class="h5 mb-1">No nodes configured</h2>
            <p class="text-sm fg-3 mb-0">Add a Wings node first, then its servers will appear here.</p>
          </div>
          <div>
            <a href="/servers" class="btn btn-solid theme-primary btn-sm">Go to List Server</a>
          </div>
        </div>
      </div>
    <% } else { %>
      <%
        function makePageUrl(targetPage) {
          var params = new URLSearchParams();
          if (filters.q) params.set('q', filters.q);
          if (filters.status) params.set('status', filters.status);
          params.set('page', String(targetPage));
          return '/docker?' + params.toString();
        }
      %>

      <div class="card shadow-sm mt-3">
        <div class="card-body">
          <form action="/docker" method="GET" class="d-flex flex-wrap align-items-end gap-2">
            <div class="form-field flex-grow-1">
              <label class="form-label" for="q">Filter</label>
              <input type="text" class="form-control" id="q" name="q" placeholder="Search server name, ID, or node" value="<%= filters.q %>">
            </div>

            <div class="form-field">
              <label class="form-label" for="status">Status</label>
              <select class="form-control" id="status" name="status">
                <option value="">All statuses</option>
                <% statuses.forEach(function (state) { %>
                  <option value="<%= state %>" <%= filters.status === state ? 'selected' : '' %>><%= state %></option>
                <% }); %>
              </select>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-solid theme-primary btn-sm">Apply</button>
              <a href="/docker" class="btn btn-outline theme-secondary btn-sm">Reset</a>
            </div>
          </form>
        </div>
      </div>

      <% unreachable.forEach(function (node) { %>
        <div class="alert theme-danger text-sm mt-3" role="alert">
          <strong><%= node.name %></strong> (Node <%= node.nodeId %>): Unable to fetch servers: <%= node.message %>
        </div>
      <% }); %>

      <div class="card shadow-sm mt-3">
        <div class="card-body">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
              <h2 class="h5 mb-1">Servers</h2>
              <p class="text-sm fg-3 mb-0"><%= totalFiltered %> matching server(s), 10 per page.</p>
            </div>
          </div>

          <% if (rows.length === 0) { %>
            <p class="text-sm fg-3 mb-0">No servers match the current filter.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0 text-sm">
                <thead>
                  <tr class="fg-2">
                    <th scope="col" class="fw-semibold">Server Name</th>
                    <th scope="col" class="fw-semibold">Server ID</th>
                    <th scope="col" class="fw-semibold">Node</th>
                    <th scope="col" class="fw-semibold">Status</th>
                    <th scope="col" class="fw-semibold">CPU</th>
                    <th scope="col" class="fw-semibold">Memory</th>
                    <th scope="col" class="fw-semibold">Disk</th>
                  </tr>
                </thead>
                <tbody>
                  <% rows.forEach(function (row) { %>
                    <tr>
                      <td><%= row.name %></td>
                      <td><code><%= row.uuid %></code></td>
                      <td>
                        <div><%= row.nodeName %></div>
                        <div class="text-sm fg-3">Node <%= row.nodeId %></div>
                      </td>
                      <td><span class="badge <%= row.stateTheme %>"><%= row.state %></span></td>
                      <td><%= row.cpuLabel %></td>
                      <td>
                        <div><%= row.memoryLabel %></div>
                        <div class="text-sm fg-3"><%= row.memoryPercent %>%</div>
                      </td>
                      <td><%= row.diskLabel %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <%- include('partials/pagination', {
              currentPage: pagination.currentPage,
              totalPages: pagination.totalPages,
              makeUrl: makePageUrl
            }) %>
          <% } %>
        </div>
      </div>
    <% } %>
  </main>
</div>
<%- include('partials/foot') %>
