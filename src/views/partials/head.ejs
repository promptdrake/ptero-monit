<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .app-shell {
      min-height: 100vh;
    }
    .app-sidebar {
      width: 100%;
      background-color: var(--bs-bg-1);
      border-bottom: 1px solid var(--bs-border-color);
    }
    @media (min-width: 1024px) {
      .app-sidebar {
        width: 264px;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        border-bottom: 0;
        border-inline-end: 1px solid var(--bs-border-color);
      }
    }
    .app-nav-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--bs-fg-2);
      text-decoration: none;
    }
    .app-nav-link:hover {
      background-color: var(--bs-bg-2);
      color: var(--bs-fg-body);
    }
    .app-nav-link.active {
      background-color: var(--bs-primary-bg-subtle);
      color: var(--bs-primary-fg-emphasis);
      font-weight: 600;
    }
    .brand-logo {
      height: 40px;
      width: auto;
      object-fit: contain;
    }
    .stat-value {
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.15;
    }
    .stat-value-sm {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.35;
      word-break: break-word;
    }
    .stat-progress {
      --bs-progress-height: 0.5rem;
    }
    .auth-bg {
      background-color: #f0f4f8;
    }
    .auth-card {
      max-width: 420px;
    }
    .auth-brand-panel {
      background: linear-gradient(160deg, #e0f2fe 0%, #f8fafc 100%);
      border-start-start-radius: var(--bs-radius-7);
      border-end-start-radius: var(--bs-radius-7);
    }
  </style>
</head>
<body class="<%= typeof bodyClass !== 'undefined' && bodyClass ? bodyClass : 'bg-body' %>">
